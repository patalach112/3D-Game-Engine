# Inspect PE imports without executing the program or requiring a graphics driver.
if(NOT EXISTS "${OBJDUMP}")
    message(FATAL_ERROR "Provide an existing OBJDUMP path")
endif()
set(BINARIES "${EXECUTABLE}")
if(ENGINE_LIBRARY)
    list(APPEND BINARIES "${ENGINE_LIBRARY}")
endif()
foreach(BINARY IN LISTS BINARIES)
    if(NOT EXISTS "${BINARY}")
        message(FATAL_ERROR "Binary does not exist: ${BINARY}")
    endif()
    execute_process(COMMAND "${OBJDUMP}" -p "${BINARY}"
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE IMPORTS ERROR_VARIABLE ERRORS)
    if(NOT STATUS EQUAL 0)
        message(FATAL_ERROR "Could not inspect ${BINARY}: ${ERRORS}")
    endif()
    string(REGEX MATCHALL "DLL Name:[^\r\n]+" DEPENDENCIES "${IMPORTS}")
    if(NOT DEPENDENCIES)
        message(FATAL_ERROR "No PE import table found in ${BINARY}")
    endif()
    message(STATUS "Imports of ${BINARY}")
    foreach(DEPENDENCY IN LISTS DEPENDENCIES)
        string(TOLOWER "${DEPENDENCY}" LOWER_DEPENDENCY)
        if(LOWER_DEPENDENCY MATCHES "libgcc_s_|libstdc[+][+]-|libwinpthread-|libssp-")
            message(FATAL_ERROR "Binary still depends on a compiler runtime: ${DEPENDENCY}")
        endif()
        message(STATUS "${DEPENDENCY}")
    endforeach()
endforeach()
