# Inspect PE imports without executing the editor or requiring a graphics driver.
if(NOT EXISTS "${EXECUTABLE}" OR NOT EXISTS "${OBJDUMP}")
    message(FATAL_ERROR "Provide existing EXECUTABLE and OBJDUMP paths")
endif()
execute_process(COMMAND "${OBJDUMP}" -p "${EXECUTABLE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE IMPORTS ERROR_VARIABLE ERRORS)
if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Could not inspect ${EXECUTABLE}: ${ERRORS}")
endif()
string(REGEX MATCHALL "DLL Name:[^\r\n]+" DEPENDENCIES "${IMPORTS}")
if(NOT DEPENDENCIES)
    message(FATAL_ERROR "No PE import table found in ${EXECUTABLE}")
endif()
foreach(DEPENDENCY IN LISTS DEPENDENCIES)
    string(TOLOWER "${DEPENDENCY}" LOWER_DEPENDENCY)
    if(LOWER_DEPENDENCY MATCHES "libgcc_s_|libstdc[+][+]-|libwinpthread-|libssp-")
        message(FATAL_ERROR "EXE still depends on a compiler runtime: ${DEPENDENCY}")
    endif()
    message(STATUS "${DEPENDENCY}")
endforeach()
