file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace engine::packed_shaders {\n")
foreach(NAME IN ITEMS object.vert hud.vert hud.frag cull.comp debug.vert)
    file(READ "${INPUT_DIR}/${NAME}.spv" HEXCODE HEX)
    string(REGEX MATCHALL "........" WORDS "${HEXCODE}")
    string(REPLACE "." "_" SYMBOL "${NAME}")
    file(APPEND "${OUTPUT}" "inline constexpr std::uint32_t ${SYMBOL}[] = {\n")
    foreach(WORD IN LISTS WORDS)
        string(SUBSTRING "${WORD}" 0 2 B0)
        string(SUBSTRING "${WORD}" 2 2 B1)
        string(SUBSTRING "${WORD}" 4 2 B2)
        string(SUBSTRING "${WORD}" 6 2 B3)
        file(APPEND "${OUTPUT}" "0x${B3}${B2}${B1}${B0}U,\n")
    endforeach()
    file(APPEND "${OUTPUT}" "};\n")
endforeach()
file(APPEND "${OUTPUT}" "}\n")
