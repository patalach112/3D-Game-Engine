# Embed at build time: executable never depends on its working directory.
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace engine::shaders {\n")
foreach(STAGE IN ITEMS vert frag)
    file(READ "${INPUT_DIR}/scene.${STAGE}.spv" HEXCODE HEX)
    string(LENGTH "${HEXCODE}" HEX_LENGTH)
    math(EXPR REMAINDER "${HEX_LENGTH} % 8")
    if(NOT REMAINDER EQUAL 0)
        message(FATAL_ERROR "Invalid SPIR-V byte count")
    endif()
    string(REGEX MATCHALL "........" WORDS "${HEXCODE}")
    file(APPEND "${OUTPUT}" "inline constexpr std::uint32_t ${STAGE}[] = {\n")
    foreach(WORD IN LISTS WORDS)
        string(SUBSTRING "${WORD}" 0 2 B0)
        string(SUBSTRING "${WORD}" 2 2 B1)
        string(SUBSTRING "${WORD}" 4 2 B2)
        string(SUBSTRING "${WORD}" 6 2 B3)
        file(APPEND "${OUTPUT}" "0x${B3}${B2}${B1}${B0}U,\n")
    endforeach()
    file(APPEND "${OUTPUT}" "};\n")
endforeach()
file(APPEND "${OUTPUT}" "}\n")
